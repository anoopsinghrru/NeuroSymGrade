      "problem_id": "prob_falling_object",
      "title": "Velocity and Work of Falling Object under Constant Acceleration (Scenarios 1 & 2)",
      "description": "An object of mass m=2kg drops from rest (u=0) under gravity a=10m/s^2 for time t=2s across distance s=20m. Find velocity, displacement, and work done.",
      "strategies": [
        {
          "strategy_id": "strat_kinematics",
          "name": "Kinematics & Newton Approach",
          "description": "Solve using standard kinematic relations followed by work calculation",
          "and_dependency_dag": {
            "1": [],
            "2": [
              1
            ],
            "3": [
              2
            ]
          },
          "steps": [
            {
              "step_id": 1,
              "concept": "Kinematics",
              "canonical_equation": "v = u + a*t",
              "expected_bindings": {
                "u": 0.0,
                "a": 10.0,
                "t": 2.0
              },
              "expected_output_value": 20.0,
              "max_marks": 5.0,
              "prerequisites": []
            },
            {
              "step_id": 2,
              "concept": "Kinematics",
              "canonical_equation": "s = (u + v)/2 * t",
              "expected_bindings": {
                "u": 0.0,
                "v": 20.0,
                "t": 2.0
              },
              "expected_output_value": 20.0,
              "max_marks": 5.0,
              "prerequisites": [
                1
              ]
            },
            {
              "step_id": 3,
              "concept": "WorkEnergyTheorem",
              "canonical_equation": "W = F * s",
              "expected_bindings": {
                "F": 20.0,
                "s": 20.0
              },
              "expected_output_value": 400.0,
              "max_marks": 5.0,
              "prerequisites": [
                2
              ]
            }
          ]
        },
        {
          "strategy_id": "strat_energy",
          "name": "Work-Energy Conservation Approach",
          "description": "Solve using direct work-energy theorem",
          "and_dependency_dag": {
            "1": []
          },
          "steps": [
            {
              "step_id": 1,
              "concept": "WorkEnergyTheorem",
              "canonical_equation": "W = 0.5 * m * v^2",
              "expected_bindings": {
                "m": 2.0,
                "v": 20.0
              },
              "expected_output_value": 400.0,
              "max_marks": 15.0,
              "prerequisites": []
            }
          ]
        }
      ]
